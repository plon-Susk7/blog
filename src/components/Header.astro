---
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS, withBase } from '../consts';
---

<header class="site-header">
  <div class="prompt-line">
    <span class="prompt-id">visitor@blog</span><span class="prompt-sep">:~$</span>
    <nav class="site-nav">
      {NAV_LINKS.map((link) => (
        <a href={withBase(link.href)}>{link.label.toLowerCase()}</a>
      ))}
    </nav>
    <span class="cursor">▋</span>
  </div>
  <ThemeToggle />
</header>
