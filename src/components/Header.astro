---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE, NAV_LINKS, withBase } from '../consts';
---

<header class="site-header">
  <a href={withBase('/')} class="site-title">{SITE_TITLE}</a>
  <nav class="site-nav">
    {NAV_LINKS.map((link) => (
      <a href={withBase(link.href)}>{link.label}</a>
    ))}
    <ThemeToggle />
  </nav>
</header>
