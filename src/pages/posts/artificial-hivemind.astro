<script is:inline>
// ---------- progress bar ----------
addEventListener('scroll', () => {
  const h = document.documentElement;
  const pct = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
  document.getElementById('progress').style.width = pct + '%';
}, { passive: true });

// ---------- convergence demo ----------
const cv = document.getElementById('plot');
const ctx = cv.getContext('2d');
const HONEY = '#e8a13d', BLUE = '#5b7fd4', GREY = '#7d8697';
let dots = [], animId = null;
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

function sizeCanvas(){
  const r = cv.getBoundingClientRect();
  cv.width = r.width * devicePixelRatio; cv.height = 340 * devicePixelRatio;
  ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
}
sizeCanvas(); addEventListener('resize', sizeCanvas);

function W(){ return cv.getBoundingClientRect().width; }
function rnd(a,b){ return a + Math.random()*(b-a); }
function gauss(){ let s=0; for(let i=0;i<6;i++) s+=Math.random(); return (s/6-0.5)*2; }

function makeDots(mode){
  const w = W(), h = 340, n = 25*10; // 250 dots for perf
  dots = [];
  for(let i=0;i<n;i++){
    const start = { x: rnd(20,w-20), y: rnd(20,h-20) };
    let tx, ty, col;
    if(mode==='hive'){
      const r = Math.random();
      if(r < 0.62){ tx = w*0.30 + gauss()*w*0.055; ty = h*0.52 + gauss()*46; col = HONEY; }
      else if(r < 0.92){ tx = w*0.72 + gauss()*w*0.042; ty = h*0.46 + gauss()*38; col = BLUE; }
      else { tx = rnd(40,w-40); ty = rnd(30,h-30); col = GREY; }
    } else {
      tx = rnd(25,w-25); ty = rnd(25,h-25);
      col = [HONEY,BLUE,GREY][i%3];
    }
    dots.push({ x:start.x, y:start.y, tx, ty, col });
  }
}
function draw(){
  const w = W(), h = 340;
  ctx.clearRect(0,0,w,h);
  ctx.strokeStyle = '#2a3140'; ctx.strokeRect(0.5,0.5,w-1,h-1);
  ctx.font = '11px Courier New'; ctx.fillStyle = '#5a5f6d';
  ctx.fillText('PCA dim 1 →', w-90, h-10);
  ctx.save(); ctx.translate(14,86); ctx.rotate(-Math.PI/2); ctx.fillText('PCA dim 2 →',0,0); ctx.restore();
  let moving = false;
  for(const d of dots){
    const dx = d.tx-d.x, dy = d.ty-d.y;
    if(Math.abs(dx)>0.5||Math.abs(dy)>0.5){ d.x += dx*(reduced?1:0.045); d.y += dy*(reduced?1:0.045); moving = true; }
    ctx.globalAlpha = 0.82;
    ctx.fillStyle = d.col;
    ctx.beginPath(); ctx.arc(d.x,d.y,3.1,0,7); ctx.fill();
  }
  ctx.globalAlpha = 1;
  if(moving) animId = requestAnimationFrame(draw);
}
function run(mode){
  cancelAnimationFrame(animId);
  makeDots(mode);
  if(reduced){ for(const d of dots){ d.x=d.tx; d.y=d.ty; } }
  draw();
}
document.getElementById('sampleBtn').addEventListener('click', ()=>run('hive'));
document.getElementById('idealBtn').addEventListener('click', ()=>run('ideal'));
run('hive'); // initial state shows the finding

// ---------- taxonomy cards ----------
document.querySelectorAll('.tax-card').forEach(c => {
  c.addEventListener('click', () => c.classList.toggle('open'));
});

// ---------- similarity bars animate on view ----------
const io = new IntersectionObserver(es => es.forEach(e => {
  if(e.isIntersecting){
    e.target.querySelectorAll('.fill').forEach(f => f.style.width = f.dataset.w + '%');
    io.unobserve(e.target);
  }
}), { threshold: 0.4 });
document.querySelectorAll('.simbar-block').forEach(b => io.observe(b));

// ---------- entropy slider ----------
const entStates = [
  { val:'1.02', name:'strong consensus', votes:[78,12,10],
    desc:'Low entropy: nearly all 25 annotators pick the same response. Example from the paper: a factual-leaning TOEFL-vs-IELTS explainer — one response was simply more complete, and people agreed (H = 1.02).' },
  { val:'1.83', name:'split with a lean', votes:[48,34,18],
    desc:'Middle entropy: a majority leans one way but a large minority genuinely prefers the alternative. Example: "Name one meaning of life" — the gene-propagation answer resonated with some annotators and left others cold (H = 1.83).' },
  { val:'2.26', name:'genuine disagreement', votes:[36,38,26],
    desc:'High entropy: votes spread almost evenly — both responses are good, and preference comes down to taste. Example: two different peanut puns (H = 2.26). This is the zone where reward models and LM judges lose alignment with humans.' }
];
const slider = document.getElementById('entSlider');
function setEnt(i){
  const s = entStates[i];
  document.getElementById('entVal').textContent = s.val;
  document.getElementById('entName').textContent = s.name;
  document.getElementById('entDesc').textContent = s.desc;
  const bars = document.querySelectorAll('#voteRow .vote');
  s.votes.forEach((v,j)=> bars[j].style.height = (v*0.9) + '%');
}
slider.addEventListener('input', e => setEnt(+e.target.value));
setEnt(0);

// ---------- quizzes ----------
document.querySelectorAll('.quiz').forEach(q => {
  const ans = +q.dataset.answer;
  q.querySelectorAll('.opt').forEach((o,i) => o.addEventListener('click', () => {
    if(q.classList.contains('answered')) return;
    q.classList.add('answered');
    o.classList.add(i===ans ? 'correct' : 'wrong');
    if(i!==ans) q.querySelectorAll('.opt')[ans].classList.add('correct');
  }));
});
</script>
